# Agent OS Environment Configuration
# Data directory (defaults to ~/.local-agent-os when empty)
AGENT_OS_DATA_DIR=
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct
VLLM_API_KEY=EMPTY
VLLM_CONTEXT_WINDOW=65536
VLLM_REQUEST_TIMEOUT=120.0
# Reasoning models: true/false sends chat_template_kwargs.enable_thinking; leave empty for server default
VLLM_ENABLE_THINKING=
# Optional vault passphrase; when empty a random key is stored at <data_dir>/vault.key
VAULT_PASSPHRASE=
